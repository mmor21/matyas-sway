#!/usr/bin/env bash
## Matyas Sway — Rofi bluetooth menu
##
## Nested menu, styled with bluetooth.rasi. Backend: bluetoothctl
## (needs BlueZ ≥ 5.65 for "devices Connected/Paired/Trusted").
##
## Modes:
##   rofi_bluetooth                    → top menu
##   rofi_bluetooth --scan             → scan for ~10s, then re-open top menu
##   rofi_bluetooth --device <MAC>     → device submenu
##
## Design notes:
##   - Pairing mode is one unified toggle (discoverable + pairable),
##     default off. It does not affect existing connections.
##   - Scanning is on-demand only. It receives, does not advertise.
##   - Device status shown inline: connected / paired / known.

set -uo pipefail

DIR="$HOME/.config/sway"
RASI="$DIR/rofi/bluetooth.rasi"
SEP="─────────"

notify() { notify-send -u low "$@" 2>/dev/null || true; }

rofi_menu() {
    local prompt="$1" mesg="$2"; shift 2
    rofi -dmenu -i -markup-rows \
        -me-select-entry "" -me-accept-entry MousePrimary \
        -p "$prompt" -mesg "$mesg" -theme "$RASI" "$@"
}

# Pango-escape (device names are free text). \& needed on bash ≥ 5.2.
esc() { local s=${1//&/\&amp;}; s=${s//</\&lt;}; printf '%s' "${s//>/\&gt;}"; }

# bt_run <ok-msg> <fail-msg> <bluetoothctl args…>
bt_run() {
    local ok="$1" fail="$2" out; shift 2
    if out="$(bluetoothctl "$@" 2>&1)"; then
        [[ -n "$ok" ]] && notify "$ok"
        return 0
    fi
    notify "$fail" "$(grep -m1 -iE 'fail|error|not available' <<< "$out")"
    return 1
}

## ── Mode: scan ──────────────────────────────────────────────────

if [[ "${1:-}" == "--scan" ]]; then
    notify "Scanning for 10 seconds…"
    bluetoothctl --timeout 10 scan on >/dev/null 2>&1 || true
    exec "$0"
fi

## ── Mode: device submenu ────────────────────────────────────────

if [[ "${1:-}" == "--device" ]]; then
    mac="${2:-}"
    [[ "$mac" =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]] || { notify "Bluetooth: invalid device"; exit 1; }

    # One "info" call instead of three.
    info="$(bluetoothctl info "$mac" 2>/dev/null)"
    field() { sed -n "s/^[[:space:]]*$1: //p" <<< "$info" | head -1; }
    name="$(field Alias)"; name="${name:-$mac}"
    connected="$(field Connected)"; paired="$(field Paired)"; trusted="$(field Trusted)"
    battery="$(field 'Battery Percentage' | sed -n 's/.*(\([0-9]*\)).*/\1/p')"

    option_conn="$([[ "$connected" == yes ]] && echo "Disconnect" || echo "Connect")"
    option_pair="$([[ "$paired" == yes ]] && echo "Unpair (removes device)" || echo "Pair")"
    option_trust="$([[ "$trusted" == yes ]] && echo "Untrust" || echo "Trust (auto-connect)")"
    option_remove="Remove this device"
    option_back="Back"

    mesg="$(esc "$name") · connected: ${connected:-?} · paired: ${paired:-?} · trusted: ${trusted:-?}"
    [[ -n "$battery" ]] && mesg+=" · battery: ${battery}%"

    choice="$(printf '%s\n' "$option_conn" "$option_pair" "$option_trust" \
        "$SEP" "$option_remove" "$option_back" | rofi_menu "Device" "$mesg")" || exit 0

    case "$choice" in
        "$option_conn")
            if [[ "$connected" == yes ]]; then
                bt_run "" "Could not disconnect $name" disconnect "$mac"
            else
                bt_run "Connected to $name" "Could not connect to $name" connect "$mac"
            fi
            exec "$0" --device "$mac" ;;
        "$option_pair")
            if [[ "$paired" == yes ]]; then
                bt_run "Unpaired $name" "Could not unpair $name" remove "$mac"; exec "$0"
            fi
            bt_run "Paired with $name" "Could not pair with $name" pair "$mac"
            exec "$0" --device "$mac" ;;
        "$option_trust")
            if [[ "$trusted" == yes ]]; then
                bt_run "" "Could not untrust $name" untrust "$mac"
            else
                bt_run "" "Could not trust $name" trust "$mac"
            fi
            exec "$0" --device "$mac" ;;
        "$option_remove")
            bt_run "Removed $name" "Could not remove $name" remove "$mac"
            exec "$0" ;;
        "$option_back")
            exec "$0" ;;
    esac
    exit 0
fi

## ── Default: top menu ───────────────────────────────────────────

show="$(bluetoothctl show 2>/dev/null)"
if ! grep -q "Powered: yes" <<< "$show"; then
    choice="$(printf '%s\n' "Turn Bluetooth on" | rofi_menu "Bluetooth" "Bluetooth is off")" || exit 0
    if [[ "$choice" == "Turn Bluetooth on" ]]; then
        bt_run "" "Could not power on Bluetooth" power on && exec "$0"
    fi
    exit 0
fi

pairing=off
grep -q "Pairable: yes" <<< "$show" && grep -q "Discoverable: yes" <<< "$show" && pairing=on
pairing_label="Pairing mode: $pairing"
power_label="Turn Bluetooth off"

# Four bluetoothctl calls in total, however many devices are known.
mapfile -t connected < <(bluetoothctl devices Connected 2>/dev/null | awk '{print $2}')
mapfile -t paired    < <(bluetoothctl devices Paired    2>/dev/null | awk '{print $2}')
declare -A state=()
for m in "${paired[@]}";    do state[$m]=paired;    done
for m in "${connected[@]}"; do state[$m]=connected; done

# Rows: fixed header, then devices (connected → paired → known), then footer.
# rofi returns the row index (-format i), so duplicate names are fine.
macs=(); rows=()
while IFS=$'\t' read -r _ mac name; do
    macs+=("$mac")
    rows+=("$(esc "$name")  <span alpha='40000'>${state[$mac]:-known}</span>")
done < <(bluetoothctl devices 2>/dev/null | while read -r _ mac name; do
            [[ -n "$mac" ]] || continue
            case "${state[$mac]:-}" in connected) r=0 ;; paired) r=1 ;; *) r=2 ;; esac
            printf '%s\t%s\t%s\n' "$r" "$mac" "$name"
         done | sort -t$'\t' -k1,1n -k3,3f)

head_rows=("$pairing_label" "$SEP")
foot_rows=("$SEP" "Scan for devices" "$power_label" "Exit")
n_head=${#head_rows[@]}; n_dev=${#rows[@]}

idx="$(printf '%s\n' "${head_rows[@]}" "${rows[@]}" "${foot_rows[@]}" | \
    rofi_menu "" "Bluetooth" -format i)" || exit 0
[[ "$idx" =~ ^[0-9]+$ ]] || exit 0

if (( idx >= n_head && idx < n_head + n_dev )); then
    exec "$0" --device "${macs[idx - n_head]}"
fi

case "$idx" in
    0)  if [[ "$pairing" == on ]]; then
            bluetoothctl pairable off >/dev/null 2>&1
            bluetoothctl discoverable off >/dev/null 2>&1
        else
            bluetoothctl pairable on >/dev/null 2>&1
            bluetoothctl discoverable on >/dev/null 2>&1
        fi
        exec "$0" ;;
    $(( n_head + n_dev + 1 ))) exec "$0" --scan ;;
    $(( n_head + n_dev + 2 ))) bt_run "Bluetooth off" "Could not power off Bluetooth" power off ;;
esac
exit 0
