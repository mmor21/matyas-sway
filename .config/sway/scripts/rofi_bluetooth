#!/usr/bin/env bash
## Matyas Sway — Rofi bluetooth menu
##
## Nested menu, styled with swayr.rasi. Backend: bluetoothctl.
##
## Modes:
##   rofi_bluetooth              → top menu
##   rofi_bluetooth --scan       → scan for ~10s, then re-open top menu
##   rofi_bluetooth --device <MAC> [--name <name>] → device submenu
##
## Design notes:
##   - Pairing mode is one unified toggle (discoverable + pairable),
##     default off. It does not affect existing connections.
##   - Scanning is on-demand only. It receives, does not advertise.
##   - Device status shown inline: connected / paired / known.

set -euo pipefail

DIR="$HOME/.config/sway"
RASI="$DIR/rofi/bluetooth.rasi"

notify() {
    notify-send -u low "$1"
}

rofi_menu() {
    local prompt="$1"
    local mesg="$2"
    rofi -dmenu -i -markup-rows \
        -me-select-entry "" -me-accept-entry MousePrimary \
        -p "$prompt" -mesg "$mesg" \
        -theme "$RASI"
}

## ── bluetoothctl helpers ────────────────────────────────────────

power_on() {
    bluetoothctl show 2>/dev/null | grep -q "Powered: yes"
}

pairable_on() {
    bluetoothctl show 2>/dev/null | grep -q "Pairable: yes"
}

discoverable_on() {
    bluetoothctl show 2>/dev/null | grep -q "Discoverable: yes"
}

pairing_mode_on() {
    pairable_on && discoverable_on
}

device_connected() {
    bluetoothctl info "$1" 2>/dev/null | grep -q "Connected: yes"
}

device_paired() {
    bluetoothctl info "$1" 2>/dev/null | grep -q "Paired: yes"
}

device_trusted() {
    bluetoothctl info "$1" 2>/dev/null | grep -q "Trusted: yes"
}

## List known devices as "MAC\tNAME\tSTATUS" sorted by status.
list_devices() {
    bluetoothctl devices 2>/dev/null | while read -r _ mac name; do
        [[ -z "$mac" ]] && continue
        local status="known"
        device_connected "$mac" && status="connected"
        [[ "$status" == "known" ]] && device_paired "$mac" && status="paired"
        printf '%s\t%s\t%s\n' "$mac" "$name" "$status"
    done | sort -t$'\t' -k3,3 -r
}

## ── Mode: scan ──────────────────────────────────────────────────

if [[ "${1:-}" == "--scan" ]]; then
    notify "Scanning for 10 seconds..."
    bluetoothctl --timeout 10 scan on >/dev/null 2>&1 || true
    notify "Scan complete."
    exec "$0"
fi

## ── Mode: device submenu ────────────────────────────────────────

if [[ "${1:-}" == "--device" ]]; then
    mac="$2"
    name="${3:-$mac}"

    connected_label="connected"
    device_connected "$mac" && connected_label="connected: yes" || connected_label="connected: no"

    if device_paired "$mac"; then paired_label="paired: yes"; else paired_label="paired: no"; fi
    if device_trusted "$mac"; then trusted_label="trusted: yes"; else trusted_label="trusted: no"; fi

    option_conn="$connected_label"
    option_pair="$paired_label"
    option_trust="$trusted_label"
    option_remove="Remove this device"
    option_back="Back"

    choice="$(printf '%s\n' "$option_conn" "$option_pair" "$option_trust" \
        "─────────" "$option_remove" "$option_back" | rofi_menu "$name" "Device actions")"
    [[ -z "$choice" ]] && exit 0

    case "$choice" in
        "$option_conn")
            if device_connected "$mac"; then
                bluetoothctl disconnect "$mac" >/dev/null 2>&1
            else
                bluetoothctl connect "$mac" >/dev/null 2>&1
            fi
            exec "$0" --device "$mac" "$name"
            ;;
        "$option_pair")
            if device_paired "$mac"; then
                bluetoothctl remove "$mac" >/dev/null 2>&1
            else
                bluetoothctl pair "$mac" >/dev/null 2>&1
            fi
            exec "$0" --device "$mac" "$name"
            ;;
        "$option_trust")
            if device_trusted "$mac"; then
                bluetoothctl untrust "$mac" >/dev/null 2>&1
            else
                bluetoothctl trust "$mac" >/dev/null 2>&1
            fi
            exec "$0" --device "$mac" "$name"
            ;;
        "$option_remove")
            bluetoothctl remove "$mac" >/dev/null 2>&1
            notify "Removed $name"
            exit 0
            ;;
        "$option_back"|"")
            exec "$0"
            ;;
    esac
    exit 0
fi

## ── Default: top menu ───────────────────────────────────────────

if ! power_on; then
    # Bluetooth is off. Offer to turn it on.
    choice="$(printf '%s\n' "Power: off" "Turn Bluetooth on" | rofi_menu "Bluetooth" "Bluetooth is off")"
    [[ "$choice" == "Turn Bluetooth on" ]] && bluetoothctl power on >/dev/null 2>&1
    exit 0
fi

if pairing_mode_on; then
    pairing_label="Pairing mode: on"
else
    pairing_label="Pairing mode: off"
fi

# Build device lines with inline status.
device_lines=""
while IFS=$'\t' read -r mac name status; do
    [[ -z "$mac" ]] && continue
    device_lines+="${name}  <span alpha='40000'>${status}</span>"$'\n'"$mac"$'\n'
done < <(list_devices)

# Note: rofi dmenu gives us a single line back; we encode MAC separately
# after a blank line so we can recover it. Simpler: build entries where
# the visible text is "NAME (status)" and a parallel lookup by name.

# Simplify: show "NAME   status" and resolve MAC by name at selection.
menu_body="$(list_devices | awk -F'\t' '{ printf "%s  (%s)\n", $2, $3 }')"

options="$pairing_label"$'\n'"─────────"$'\n'
if [[ -n "$menu_body" ]]; then
    options+="$menu_body"$'\n'
fi
options+="─────────"$'\n'"Scan for devices"$'\n'"Exit"

choice="$(printf '%s\n' "$options" | rofi_menu "" "Bluetooth")"
[[ -z "$choice" ]] && exit 0

case "$choice" in
    "$pairing_label")
        if pairing_mode_on; then
            bluetoothctl pairable off >/dev/null 2>&1
            bluetoothctl discoverable off >/dev/null 2>&1
        else
            bluetoothctl pairable on >/dev/null 2>&1
            bluetoothctl discoverable on >/dev/null 2>&1
        fi
        exec "$0"
        ;;
    "Scan for devices")
        exec "$0" --scan
        ;;
    "Exit"|"─────────")
        exit 0
        ;;
    *)
        # Device selected. Extract name from "NAME  (status)".
        sel_name="${choice%%  (*}"
        mac="$(bluetoothctl devices 2>/dev/null | awk -v n="$sel_name" '{
            # Bluetooth lines look like: Device AA:BB:CC:DD:EE:FF Name With Spaces
            mac=$2; $1=""; $2=""; sub(/^  */, ""); if ($0 == n) { print mac; exit }
        }')"
        [[ -z "$mac" ]] && exit 0
        exec "$0" --device "$mac" "$sel_name"
        ;;
esac
