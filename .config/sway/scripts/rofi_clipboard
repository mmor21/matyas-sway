#!/usr/bin/env bash
## Matyas Sway — Clipboard history via rofi + cliphist
##
## Uses rofi's custom-mode interface. The cliphist-rofi helper script
## provides the entry list and handles the selection action.

set -euo pipefail

DIR="$HOME/.config/sway"
RASI="$DIR/rofi/launcher.rasi"
HELPER="$DIR/scripts/cliphist-rofi"

# If history is empty, notify and exit cleanly.
if [[ -z "$(cliphist list | head -1)" ]]; then
    notify-send -u low "Clipboard history is empty."
    exit 0
fi

# rofi custom-mode: the helper is called for both list and action.
exec rofi -modi "clipboard:$HELPER" -show clipboard -show-icons \
    -i -me-select-entry "" -me-accept-entry MousePrimary \
    -theme "$RASI"
