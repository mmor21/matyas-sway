#!/usr/bin/env bash
## Matyas Sway — Clipboard history via rofi + cliphist
##
## Shows the most recent clipboard entries. Selecting one copies it
## back to the clipboard.

set -euo pipefail

DIR="$HOME/.config/sway"
RASI="$DIR/rofi/launcher.rasi"
MAX_ENTRIES=50

# If history is empty, notify and exit cleanly.
if [[ -z "$(cliphist list | head -1)" ]]; then
    notify-send -u low "Clipboard history is empty."
    exit 0
fi

# Pipe the most recent entries to rofi.
chosen="$(cliphist list | head -n "$MAX_ENTRIES" | \
    rofi -dmenu -i -me-select-entry "" -me-accept-entry MousePrimary \
    -p "Clipboard" -theme "$RASI")"

[[ -z "$chosen" ]] && exit 0

# Decode and copy the selected entry to the clipboard.
printf '%s' "$chosen" | cliphist decode | wl-copy
