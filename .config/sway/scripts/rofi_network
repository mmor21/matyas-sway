#!/usr/bin/env bash
## Matyas Sway — Network menu (via networkmanager_dmenu)
## Bound to: $mod+n

DIR="$HOME/.config/sway"
CONFIG="$DIR/rofi/networkmenu_config.ini"

if ! command -v networkmanager_dmenu >/dev/null 2>&1; then
    notify-send -u normal "networkmanager_dmenu is not installed."
    exit 1
fi

exec networkmanager_dmenu --config "$CONFIG"
