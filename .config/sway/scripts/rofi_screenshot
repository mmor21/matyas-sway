#!/usr/bin/env bash
## Matyas Sway — Rofi screenshot menu
## Bound to: $mod+s

set -euo pipefail

DIR="$HOME/.config/sway"
RASI="$DIR/rofi/screenshot.rasi"
SCRIPT="$DIR/scripts/screenshot"

option_1='Capture Desktop'
option_2='Capture Area'
option_3='Capture Window'
option_4='Capture in 5s'
option_5='Capture in 10s'

rofi_cmd() {
    rofi -dmenu -p 'Screenshot' -mesg "Saved to: $(xdg-user-dir PICTURES)/Screenshots" -markup-rows -theme "$RASI"
}

run_rofi() {
    printf '%s\n' "$option_1" "$option_2" "$option_3" "$option_4" "$option_5" | rofi_cmd
}

chosen="$(run_rofi)"
case "$chosen" in
    "$option_1") "$SCRIPT" --now ;;
    "$option_2") "$SCRIPT" --area ;;
    "$option_3") "$SCRIPT" --win ;;
    "$option_4") "$SCRIPT" --in5 ;;
    "$option_5") "$SCRIPT" --in10 ;;
esac
