#!/usr/bin/env bash
## Matyas Sway — Rofi theme menu
## Bound to: $mod+Ctrl+t
##
## Four entries:
##   Change Wallpaper  — opens the wallpaper picker
##   Dark theme        — base16-ocean (default)
##   Light theme       — Measured Light
##   IC Orange PPL     — matches the Ghostty theme of the same name

set -euo pipefail

DIR="$HOME/.config/sway"
RASI="$DIR/rofi/theme.rasi"
THEME_SH="$DIR/theme/theme.sh"
WALLPAPER_PICKER="$DIR/scripts/rofi_wallpaper"

prompt="Theme"
mesg="Pick an option"

option_1='Change Wallpaper'
option_2='Dark theme'
option_3='Light theme'
option_4='IC Orange PPL'

rofi_cmd() {
    rofi -dmenu -i -markup-rows \
        -me-select-entry "" -me-accept-entry MousePrimary \
        -p "$prompt" -mesg "$mesg" -theme "$RASI"
}

run_rofi() {
    printf '%s\n' "$option_1" "$option_2" "$option_3" "$option_4" | rofi_cmd
}

chosen="$(run_rofi)"
case "$chosen" in
    "$option_1") exec "$WALLPAPER_PICKER" ;;
    "$option_2") exec "$THEME_SH" --dark ;;
    "$option_3") exec "$THEME_SH" --light ;;
    "$option_4") exec "$THEME_SH" --orange ;;
esac
