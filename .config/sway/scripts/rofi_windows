#!/usr/bin/env bash
## Matyas Sway — Rofi window switcher
##
## Lists all windows (Wayland + XWayland, incl. scratchpad) across all
## workspaces with app icons. Selecting an entry focuses that window.

set -uo pipefail

DIR="$HOME/.config/sway"
RASI="$DIR/rofi/swayr.rasi"

# Pango-escape arbitrary text for -markup-rows.
esc() {
    # \& is needed: bash 5.2+ (patsub_replacement) expands a bare & to the match.
    local s=${1//&/\&amp;}
    s=${s//</\&lt;}
    printf '%s' "${s//>/\&gt;}"
}

# Resolve an icon *name* for rofi's own theme lookup:
# 1) Icon= from a matching .desktop file, 2) the app_id/class itself.
declare -A ICON_CACHE
icon_for() {
    local id="$1" key="${1,,}" f icon=""
    [[ -n "${ICON_CACHE[$key]+x}" ]] && { printf '%s' "${ICON_CACHE[$key]}"; return; }
    for f in {"$HOME/.local/share","/usr/share","/var/lib/flatpak/exports/share"}/applications/{"$id","$key","${id##*.}","${key##*.}"}.desktop; do
        if [[ -f "$f" ]]; then
            icon="$(sed -n 's/^Icon=//p' "$f" | head -1)"
            break
        fi
    done
    [[ -z "$icon" ]] && icon="$key"
    ICON_CACHE[$key]="$icon"
    printf '%s' "$icon"
}

# Read windows into arrays in the *main* shell (no pipeline subshell),
# so no temp file is needed for the index → con_id mapping.
ids=(); rows=(); icons=()
while IFS=$'\t' read -r con_id app title ws focused; do
    [[ -z "$con_id" ]] && continue
    (( ${#title} > 60 )) && title="${title:0:57}…"
    mark=""; [[ "$focused" == 1 ]] && mark=" ●"
    ids+=("$con_id")
    rows+=("<span alpha=\"45000\">[$(esc "$ws")]</span> <i>$(esc "${app##*.}")</i> — $(esc "$title")$mark")
    icons+=("$(icon_for "$app")")
done < <(swaymsg -t get_tree | jq -r '
    .. | objects | select(.type=="workspace") | .name as $ws
    | (.nodes[]?, .floating_nodes[]?) | .. | objects
    | select(.type=="con" or .type=="floating_con")
    | select(.app_id != null or .window_properties != null)
    | [ (.id|tostring),
        (.app_id // .window_properties.class // "unknown"),
        ((.name // "untitled") | gsub("[\t\n]"; " ")),
        (if $ws == "__i3_scratch" then "scratch" else $ws end),
        (if .focused then "1" else "0" end) ] | @tsv')

(( ${#ids[@]} )) || exit 0

# NUL can't live in a bash variable, so the \0icon\x1f suffix is added here.
index="$(for i in "${!rows[@]}"; do
            printf '%s\0icon\x1f%s\n' "${rows[$i]}" "${icons[$i]}"
         done | rofi -dmenu -i -markup-rows -show-icons \
    -click-to-exit -me-select-entry "" -me-accept-entry MousePrimary \
    -format 'i' -theme "$RASI" -p "Windows")" || exit 0

[[ "$index" =~ ^[0-9]+$ ]] || exit 0
con_id="${ids[$index]:-}"
[[ -n "$con_id" ]] && swaymsg -q "[con_id=$con_id] focus"
