##-- Style -------------------------------
default_border pixel 2
default_floating_border pixel 2
smart_borders off

titlebar_border_thickness 2
titlebar_padding 6 6
title_align center

gaps inner 10
gaps outer 0

##-- Colors ------------------------------
## These are placeholders. theme.sh rewrites them in place when the
## user selects a different Base16 scheme or a pywal-generated palette.
## The format matches Base16: background, foreground, and 16 slots.
set $sway_cl_col_bg   #2b303b
set $sway_cl_col_fg   #c0c5ce
set $sway_cl_col_in   #65737e
set $sway_cl_col_afoc #8fa1b3
set $sway_cl_col_ifoc #4f5b66
set $sway_cl_col_ufoc #343d46
set $sway_cl_col_urgt #bf616a
set $sway_cl_col_phol #2b303b

# class                  border              background          text                indicator           child_border
client.focused           $sway_cl_col_afoc   $sway_cl_col_afoc   $sway_cl_col_bg     $sway_cl_col_in     $sway_cl_col_afoc
client.focused_inactive  $sway_cl_col_ifoc   $sway_cl_col_ifoc   $sway_cl_col_bg     $sway_cl_col_in     $sway_cl_col_ifoc
client.unfocused         $sway_cl_col_ufoc   $sway_cl_col_ufoc   $sway_cl_col_fg     $sway_cl_col_in     $sway_cl_col_ufoc
client.urgent            $sway_cl_col_urgt   $sway_cl_col_urgt   $sway_cl_col_fg     $sway_cl_col_in     $sway_cl_col_urgt
client.placeholder       $sway_cl_col_phol   $sway_cl_col_phol   $sway_cl_col_fg     $sway_cl_col_in     $sway_cl_col_phol
client.background        $sway_cl_col_bg

##-- GTK / icon / cursor / font -----------
set $sway_gtk_theme    Adwaita
set $sway_icon_theme   Papirus
set $sway_cursor_theme Adwaita
set $sway_fonts        Noto Sans Mono 10

set $gnome-schema org.gnome.desktop.interface

exec_always {
    gsettings set $gnome-schema gtk-theme    $sway_gtk_theme
    gsettings set $gnome-schema icon-theme   $sway_icon_theme
    gsettings set $gnome-schema cursor-theme $sway_cursor_theme
    gsettings set $gnome-schema font-name    $sway_fonts
    gsettings set $gnome-schema color-scheme 'prefer-dark'
}

